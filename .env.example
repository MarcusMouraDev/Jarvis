# Copie para .env.local e preencha. Nunca commitar segredos.

# Google Gemini (alias: gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cursor SDK / Agent (alias: cursor-text no Safe Core)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_AGENT_CWD=

# Safe Agent Core (0=legado V23, 1=shell/API seguros)
# JARVIS_SAFE_AGENT_CORE=0

# Skills — o runtime já inclui ~/.cursor, ~/.codex, ~/.claude e ~/.agents.
# Use CURSOR_SKILLS_DIRS só para pastas extras (separadas por :)
# CURSOR_SKILLS_DIRS=/path/to/extra-skills

# DeepSeek (opcional; fallback do gemini)
# DEEPSEEK_API_KEY=

# Groq Whisper (grátis) — entrada de voz via POST /api/voice/transcribe
# Cadastro: https://console.groq.com/login
# API Keys: https://console.groq.com/keys
# WHISPER_API_KEY=gsk_...
# WHISPER_API_BASE=https://api.groq.com/openai/v1
# WHISPER_MODEL=whisper-large-v3-turbo

# OpenAI Whisper (pago) — alternativa
# OPENAI_API_KEY=
# WHISPER_API_BASE=https://api.openai.com
# WHISPER_MODEL=whisper-1

# OmniRoute — OpenAI-compatible local (alias: local no Safe Core)
# Suba o sidecar em http://127.0.0.1:20128 antes de usar.
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:20128
LOCAL_OPENAI_API_KEY=not-needed
LOCAL_OPENAI_MODEL=auto

# Tools MCP OmniRoute (leitura: modelos, quota, compressão, relatório 7d)
# Ligado automaticamente no `npm run desktop`.
# JARVIS_OMNIROUTE_MCP=1

# OmniRoute sidecar heap (MB). Default do launcher: 768. Evite npm run dev (8GB).
# OMNIROUTE_MEMORY_MB=768
# JARVIS_OMNI_DEV=1   # só se precisar do HMR do OmniRoute
# JARVIS_NEXT_DEV=1   # npm run desktop:dev — Next do Jarvis em turbopack

# Smart routing (0=off, 1=on)
# JARVIS_SMART_ROUTING=0
# Response soul preferences: compact, neutral, or formal; optional address.
# JARVIS_RESPONSE_STYLE=neutral
# JARVIS_PREFERRED_ADDRESS=

# Tool executor (required for shell/tools API)
# JARVIS_TOOL_EXECUTOR=0

# Phase 6 integrations (all OFF by default)
# JARVIS_MCP_BRASIL=0
# JARVIS_BROWSER=0
# JARVIS_BROWSER_ALLOWLIST=example.com,localhost,127.0.0.1
# JARVIS_BROWSER_MOCK=0
# JARVIS_SCHEDULER=0

# Hermes sidecar
HERMES_GATEWAY_URL=ws://127.0.0.1:9119/api/ws
HERMES_GATEWAY_HTTP=http://127.0.0.1:9119
HERMES_HOME=$HOME/.hermes/profiles/jarvis
HERMES_BIN=$HOME/.hermes/venvs/hermes-313/bin/hermes
HERMES_DEFAULT_CWD=$HOME/Projetos

# Private Hermes -> Jarvis model broker (required in OCI Compose)
# HERMES_MODEL_BROKER_URL=http://jarvis:3000/api/internal/hermes/v1/chat/completions
# HERMES_BROKER_TOKEN=
# HERMES_MODEL_BROKER_TOKEN=  # alias used by some Hermes provider configs
# HERMES_JARVIS_BROKER_MODEL=jarvis-broker
# JARVIS_HERMES_MODEL_ALIAS=local
