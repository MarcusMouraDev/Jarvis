# Copie para .env.local e preencha. Nunca commitar segredos.

# Google Gemini (alias: gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cursor SDK / Agent (alias: codex)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_AGENT_CWD=

# Diretórios extras de skills (separados por : )
# Padrão já inclui ~/.cursor/skills-cursor e ~/.cursor/skills
# CURSOR_SKILLS_DIRS=

# DeepSeek (opcional; fallback do gemini)
# DEEPSEEK_API_KEY=

# MiniMax voz (opcional)
# MINIMAX_API_KEY=
