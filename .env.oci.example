# Copy to /srv/jarvis/.env. Never commit this file with secrets.
JARVIS_IMAGE=ghcr.io/marcusmouradev/jarvis@sha256:REPLACE_WITH_VERIFIED_ARM64_DIGEST
HERMES_IMAGE=ghcr.io/marcusmouradev/hermes-agent@sha256:REPLACE_WITH_VERIFIED_ARM64_DIGEST
OMNIROUTE_IMAGE=ghcr.io/marcusmouradev/omniroute@sha256:REPLACE_WITH_VERIFIED_ARM64_DIGEST
JARVIS_SAFE_AGENT_CORE=1
JARVIS_DATA_DIR=/var/lib/jarvis
JARVIS_DATA_ROOT=/srv/jarvis
JARVIS_TRUST_TAILSCALE_HEADERS=1
JARVIS_TAILSCALE_HOSTS=jarvis-hermes-oci.YOUR-TAILNET.ts.net
JARVIS_TAILSCALE_LOGIN_ALLOWLIST=YOUR-TAILSCALE-LOGIN@example.com
HERMES_JARVIS_BROKER_MODEL=jarvis-broker
HERMES_BROKER_TOKEN=REPLACE_WITH_RANDOM_SECRET
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_HERMES_MODEL_ALIAS=local
LOCAL_OPENAI_BASE_URL=http://omniroute:20128
LOCAL_OPENAI_MODEL=jarvis-broker
JARVIS_WEB_CPUS=0.5
JARVIS_WEB_MEMORY=1024M
JARVIS_WORKER_CPUS=0.5
JARVIS_WORKER_MEMORY=1024M
RESTIC_REPOSITORY=/srv/jarvis/backups/restic
# RESTIC_PASSWORD_FILE=/run/secrets/restic_password
